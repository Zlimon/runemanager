APP_NAME=RuneManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=runemanager
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Player MongoDB (banks, inventories, quests, looting bags)
MONGODB_URI="mongodb://sail:password@mongodb:27017/runemanager?authSource=admin"
# mongodb://sail:password@localhost:27017/runemanager?authSource=admin&directConnection=true
MONGODB_DATABASE=runemanager
# Static MongoDB (items, monsters, prayers)
MONGODB_STATIC_URI="mongodb://sail:password@mongodb-static:27017/gamedata?authSource=admin"
# mongodb://sail:password@localhost:27018/gamedata?authSource=admin&directConnection=true
MONGODB_STATIC_DATABASE=gamedata

# Wise Old Man (optional API key raises the rate limit)
WOM_API_URL=https://api.wiseoldman.net/v2
WOM_API_KEY=
WOM_USER_AGENT="RuneManager (+https://runemanager.com)"
